#!/bin/bash
set -euo pipefail

# Build the panaudia-lasa image (the panaudia-server binary) from this checkout.
#
#   docker/build                 # linux/amd64, version from the server/v* git tag
#   docker/build dev             # explicit version
#   PLATFORM=linux/arm64 docker/build
#   TARGET=bench docker/build    # the capacity ceiling harness image, tagged -bench
#
# The version is `git describe --match 'server/v*' --dirty` with the
# server/ prefix removed (0.3.0 on the tagged commit, 0.3.0-2-gea3c742-dirty
# past it); it is baked into the binary (-X main.version) and used for
# the image tag panaudia/panaudia-lasa:<version>-<arch>. Tag releases
# `git tag server/vX.Y.Z`. Pass --push via BUILD_ARGS to publish, e.g.
# BUILD_ARGS=--push docker/build.

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
REPO_ROOT="$( cd "$SCRIPT_DIR/.." && pwd )"

PLATFORM="${PLATFORM:-linux/amd64}"
ARCH="${PLATFORM#linux/}"
TARGET="${TARGET:-runtime}"
if [ $# -ge 1 ]; then
  VERSION="$1"
else
  DESCRIBE="$(git -C "$REPO_ROOT" describe --tags --match 'server/v*' --dirty --always 2>/dev/null || true)"
  case "$DESCRIBE" in
    server/v*) VERSION="${DESCRIBE#server/v}" ;;
    "")        VERSION="dev" ;;
    *)         VERSION="0.0.0-g${DESCRIBE}" ;; # no server/v* tag yet: commit only
  esac
fi
IMAGE="panaudia/panaudia-lasa:${VERSION}-${ARCH}"
if [ "$TARGET" != "runtime" ]; then
  IMAGE="${IMAGE}-${TARGET}"
fi

echo "Building $IMAGE for $PLATFORM (target $TARGET)"
docker buildx build \
  --platform "$PLATFORM" \
  --target "$TARGET" \
  --build-arg "VERSION=$VERSION" \
  -f "$SCRIPT_DIR/Dockerfile" \
  -t "$IMAGE" \
  ${BUILD_ARGS:---load} \
  "$REPO_ROOT"
