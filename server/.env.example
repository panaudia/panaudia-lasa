# panaudia-server configuration.
#
# Every setting is an environment variable. For development, copy this
# file to .env beside the binary (or point PANAUDIA_ENV_FILE at it) and
# it is loaded at startup; variables already set in the real
# environment always win over the file. Defaults apply to anything
# unset. The server prints its full effective configuration, with each
# value's source, when it starts.

# --- network ---------------------------------------------------------
# Bind address; empty = all interfaces.
PANAUDIA_HOST=
# UDP port for QUIC (raw MoQ) and HTTP/3 (WebTransport) alike.
PANAUDIA_PORT=4443
# TCP port for the plain-HTTP operations endpoints: GET /healthz
# (liveness), /readyz (503 once shutdown begins, so a balancer drains),
# /stats (JSON snapshot). 0 = off. Meant for probes and collectors on
# the private network, not the public internet.
PANAUDIA_HTTP_PORT=0
# The space id this process serves. In a ticketed space, tickets must
# carry it as `aud`.
PANAUDIA_SPACE=main

# --- TLS -------------------------------------------------------------
# Certificate and key, set together. Both empty = an ephemeral
# self-signed development certificate; the server logs its hash for
# WebTransport serverCertificateHashes.
PANAUDIA_CERT=
PANAUDIA_KEY=

# --- admission -------------------------------------------------------
# A space is EITHER ticketed OR open, decided explicitly.
# Ticketed: the issuer's Ed25519 public key, base64 of the raw 32 bytes.
PANAUDIA_TICKET_KEY=
# Open (development): anyone connects, no ticket. Never combine with a
# ticket key; never leave both unset.
PANAUDIA_ALLOW_UNTICKETED=true

# --- rendering -------------------------------------------------------
# Internal ambisonic bus order, 2-5. The sink offering follows it:
# ambi2 always, ambi3 at 3 and above.
PANAUDIA_ORDER=3
# Concurrent entity capacity; admission refuses beyond it.
PANAUDIA_MAX_ENTITIES=64
# Render worker goroutines.
PANAUDIA_WORKERS=16
# Reverb preset: none | tight-room | small-room | medium-room |
# large-hall | cathedral.
PANAUDIA_REVERB=medium-room

# --- diagnostics -----------------------------------------------------
# Stats line cadence in seconds (>= 1). At 15 or below, one detail line
# per entity is logged as well (jitter-debugging mode).
PANAUDIA_STATS_SEC=60
# debug | info | warn | error
PANAUDIA_LOG_LEVEL=info
# text (for a terminal) | json (one object per line, for a collector).
PANAUDIA_LOG_FORMAT=text
# true forces the pure-Go mixing path over the GEMM backend. An A/B and
# benchmark hatch; output is identical, only speed differs.
PANAUDIA_MIXER_GONUM=false
